NODE_ENV=production
PORT=4000

AGENCYOPS_API_PORT=4000
AGENCYOPS_WEB_PORT=5173

POSTGRES_DB=agencyops
POSTGRES_USER=agencyops
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://agencyops:replace-with-a-long-url-safe-password@postgres:5432/agencyops
REDIS_URL=redis://redis:6379

WEB_APP_URL=https://agencyops.example.com
API_URL=https://agencyops.example.com/api
CORS_ORIGIN=https://agencyops.example.com

VITE_API_URL=/api
VITE_PUBLIC_ORGANIZATION_SLUG=northstar-digital-agency

COOKIE_SECRET=replace-with-a-long-random-value
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

EMAIL_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=ops@agencyops.example.com

WEBHOOK_TIMEOUT_MS=5000
LOG_LEVEL=info
